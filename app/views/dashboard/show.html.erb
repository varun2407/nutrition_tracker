<% content_for(:title) { "Home | Nutrition Tracker" } %>

<div class="w-full max-w-7xl mx-auto bg-gradient-to-br from-gray-50 via-blue-50 to-purple-50 pb-12 overflow-x-hidden">
  <!-- Hero Stats Section -->
  <div class="mb-8 pt-4 px-4 lg:px-0">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Today's Overview</h1>
        <p class="text-gray-600"><%= @selected_date.strftime("%A, %B %d, %Y") %></p>
      </div>
      <form method="get" action="/" class="mt-4 md:mt-0">
        <div class="flex items-center space-x-3 bg-white rounded-xl shadow-sm border border-gray-200 px-4 py-3">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <input
            type="date"
            id="date"
            name="date"
            value="<%= @selected_date.strftime('%Y-%m-%d') %>"
            class="border-none outline-none text-gray-700 font-medium bg-transparent"
            onchange="this.form.submit()"
          />
        </div>
      </form>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <!-- Total Calories Card -->
      <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl shadow-lg p-6 text-white transform hover:scale-105 transition-transform duration-200">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-white/20 rounded-lg p-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
        </div>
        <p class="text-blue-100 text-sm font-medium mb-1">Total Calories</p>
        <p class="text-4xl font-bold"><%= @total_calories %></p>
        <p class="text-blue-100 text-sm mt-2">kcal consumed</p>
      </div>

      <!-- Remaining Calories Card -->
      <div class="bg-gradient-to-br <%= @remaining_calories > 0 ? 'from-green-500 to-green-600' : 'from-red-500 to-red-600' %> rounded-2xl shadow-lg p-6 text-white transform hover:scale-105 transition-transform duration-200">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-white/20 rounded-lg p-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <p class="<%= @remaining_calories > 0 ? 'text-green-100' : 'text-red-100' %> text-sm font-medium mb-1">Remaining</p>
        <p class="text-4xl font-bold"><%= @remaining_calories.abs %></p>
        <p class="<%= @remaining_calories > 0 ? 'text-green-100' : 'text-red-100' %> text-sm mt-2"><%= @remaining_calories > 0 ? 'kcal left' : 'kcal over' %></p>
      </div>

      <!-- Progress Card -->
      <div class="bg-white rounded-2xl shadow-lg p-6 transform hover:scale-105 transition-transform duration-200">
        <div class="flex items-center justify-between mb-4">
          <div class="bg-purple-100 rounded-lg p-3">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
        </div>
        <p class="text-gray-600 text-sm font-medium mb-1">Daily Progress</p>
        <%
          daily_goal = 2000
          percent_consumed = daily_goal > 0 ? (@total_calories.to_f / daily_goal * 100).round : 0
          percent_consumed = [percent_consumed, 100].min
        %>
        <p class="text-4xl font-bold text-gray-900"><%= percent_consumed %>%</p>
        <div class="mt-4">
          <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
            <div
              class="h-3 rounded-full transition-all duration-500 <%= @remaining_calories > 0 ? 'bg-gradient-to-r from-blue-500 to-blue-600' : 'bg-gradient-to-r from-red-500 to-red-600' %>"
              style="width: <%= percent_consumed %>%"
            ></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 px-4 lg:px-0">
    <!-- Left Column: Search -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-2xl shadow-lg p-6 lg:sticky lg:top-32">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
          <svg class="w-6 h-6 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Find Food
        </h2>
        <%= render partial: "food_search/search", locals: { foods: [], daily_log_id: @daily_log.id, user_id: current_user.id } %>
      </div>
    </div>

    <!-- Right Column: Food Log and Charts -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Food Log -->
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <div id="dashboard_food_log">
          <%= render partial: "food_log", locals: { daily_log: @daily_log } %>
        </div>
      </div>

      <!-- Charts Section -->
      <div class="grid grid-cols-1 gap-6">
        <!-- Weekly Chart -->
        <div class="bg-white rounded-2xl shadow-lg p-6">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-bold text-gray-900 flex items-center">
              <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              Weekly Overview
            </h3>
          </div>
          <div class="h-64 w-full overflow-hidden">
            <%= bar_chart @daily_calories_weekly,
                class: 'w-full h-full',
                title: "",
                options: {
                  series: {
                    barWidth: '60%',
                    itemStyle: {
                      color: {
                        type: 'linear',
                        x: 0,
                        y: 0,
                        x2: 0,
                        y2: 1,
                        colorStops: [
                          { offset: 0, color: '#3B82F6' },
                          { offset: 1, color: '#8B5CF6' }
                        ]
                      },
                      borderRadius: [8, 8, 0, 0]
                    }
                  },
                  tooltip: {
                    trigger: 'axis',
                    axisPointer: {
                      type: 'shadow'
                    },
                    backgroundColor: 'rgba(0, 0, 0, 0.8)',
                    borderColor: 'transparent',
                    textStyle: { color: '#fff' },
                    formatter: RailsCharts.js("(params) => {
                      const value = params[0].value;
                      return `<div class='p-3'>
                        <div class='font-bold text-white mb-1'>${params[0].name}</div>
                        <div class='text-blue-400 font-semibold text-lg'>${value} kcal</div>
                      </div>`;
                    }")
                  },
                  grid: {
                    left: '10%',
                    right: '5%',
                    bottom: '15%',
                    top: '10%',
                    containLabel: true
                  },
                  xAxis: {
                    type: 'category',
                    axisLine: {
                      show: false
                    },
                    axisTick: {
                      show: false
                    },
                    axisLabel: {
                      color: '#6B7280',
                      fontWeight: '500'
                    }
                  },
                  yAxis: {
                    type: 'value',
                    axisLine: {
                      show: false
                    },
                    axisTick: {
                      show: false
                    },
                    splitLine: {
                      lineStyle: {
                        color: '#F3F4F6',
                        width: 1
                      }
                    },
                    axisLabel: {
                      color: '#6B7280',
                      formatter: '{value} kcal',
                      fontWeight: '500'
                    }
                  },
                  animation: true,
                  animationDuration: 1000,
                  animationEasing: 'elasticOut'
                }
              %>
          </div>
        </div>

        <!-- Monthly Chart -->
        <div class="bg-white rounded-2xl shadow-lg p-6">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-bold text-gray-900 flex items-center">
              <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Monthly Trends
            </h3>
          </div>
          <div class="h-64 w-full overflow-hidden">
            <%= bar_chart @daily_calories_monthly,
                class: 'w-full h-full',
                title: "",
                options: {
                  series: {
                    barWidth: '40%',
                    itemStyle: {
                      color: {
                        type: 'linear',
                        x: 0,
                        y: 0,
                        x2: 0,
                        y2: 1,
                        colorStops: [
                          { offset: 0, color: '#6366F1' },
                          { offset: 1, color: '#A855F7' }
                        ]
                      },
                      borderRadius: [8, 8, 0, 0]
                    }
                  },
                  tooltip: {
                    trigger: 'axis',
                    axisPointer: {
                      type: 'shadow'
                    },
                    backgroundColor: 'rgba(0, 0, 0, 0.8)',
                    borderColor: 'transparent',
                    textStyle: { color: '#fff' },
                    formatter: RailsCharts.js("(params) => {
                      const value = params[0].value;
                      return `<div class='p-3'>
                        <div class='font-bold text-white mb-1'>${params[0].name}</div>
                        <div class='text-purple-400 font-semibold text-lg'>${value} kcal</div>
                      </div>`;
                    }")
                  },
                  grid: {
                    left: '10%',
                    right: '5%',
                    bottom: '20%',
                    top: '10%',
                    containLabel: true
                  },
                  xAxis: {
                    type: 'category',
                    axisLine: {
                      show: false
                    },
                    axisTick: {
                      show: false
                    },
                    axisLabel: {
                      color: '#6B7280',
                      fontWeight: '500',
                      rotate: 45,
                      interval: 0
                    }
                  },
                  yAxis: {
                    type: 'value',
                    axisLine: {
                      show: false
                    },
                    axisTick: {
                      show: false
                    },
                    splitLine: {
                      lineStyle: {
                        color: '#F3F4F6',
                        width: 1
                      }
                    },
                    axisLabel: {
                      color: '#6B7280',
                      formatter: '{value} kcal',
                      fontWeight: '500'
                    }
                  },
                  animation: true,
                  animationDuration: 1000,
                  animationEasing: 'elasticOut'
                }
              %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
