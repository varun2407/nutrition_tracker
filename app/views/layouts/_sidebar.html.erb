<% if authenticated? %>
  <aside id="sidebar" class="fixed left-0 top-0 h-screen w-72 bg-white border-r border-gray-200 shadow-sm z-50 transform transition-transform duration-300 ease-in-out lg:translate-x-0 -translate-x-full flex flex-col" data-sidebar>
    <!-- Sidebar Header -->
    <div class="flex items-center justify-between p-6 border-b border-gray-100 flex-shrink-0">
      <div class="flex items-center space-x-3">
        <div class="bg-gradient-to-br from-blue-500 via-purple-500 to-pink-500 rounded-xl p-2.5 shadow-lg">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <h1 class="text-lg font-bold text-gray-900">Nutrition</h1>
          <p class="text-xs text-gray-500">Tracker</p>
        </div>
      </div>
      <!-- Mobile close button -->
      <button id="sidebar-close" class="lg:hidden text-gray-400 hover:text-gray-600 transition-colors p-1 rounded-lg hover:bg-gray-100" onclick="document.getElementById('sidebar').classList.add('-translate-x-full'); document.getElementById('sidebar-overlay').classList.add('hidden');">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Links -->
    <nav class="flex-1 overflow-y-auto py-4 min-h-0">
      <div class="px-3 space-y-1">
        <%= link_to root_path, class: "group flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200 #{controller_name == 'dashboard' ? 'bg-blue-50 text-blue-700 border border-blue-100' : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <div class="<%= controller_name == 'dashboard' ? 'text-blue-600' : 'text-gray-400 group-hover:text-gray-600' %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <span class="font-medium text-sm"><%= controller_name == 'dashboard' ? 'Dashboard' : 'Dashboard' %></span>
        <% end %>

        <%= link_to analytics_path, class: "group flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200 #{controller_name == 'analytics' ? 'bg-blue-50 text-blue-700 border border-blue-100' : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <div class="<%= controller_name == 'analytics' ? 'text-blue-600' : 'text-gray-400 group-hover:text-gray-600' %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <span class="font-medium text-sm">Analytics</span>
        <% end %>

        <%= link_to weight_logs_path, class: "group flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200 #{controller_name == 'weight_logs' ? 'bg-blue-50 text-blue-700 border border-blue-100' : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <div class="<%= controller_name == 'weight_logs' ? 'text-blue-600' : 'text-gray-400 group-hover:text-gray-600' %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <span class="font-medium text-sm">Weight Tracking</span>
        <% end %>

        <%= link_to edit_profile_path(:user_id), class: "group flex items-center space-x-3 px-4 py-3 rounded-xl transition-all duration-200 #{controller_name == 'profiles' ? 'bg-blue-50 text-blue-700 border border-blue-100' : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900'}" do %>
          <div class="<%= controller_name == 'profiles' ? 'text-blue-600' : 'text-gray-400 group-hover:text-gray-600' %>">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <span class="font-medium text-sm">Profile</span>
        <% end %>
      </div>
    </nav>

    <!-- User Section -->
    <div class="p-4 border-t border-gray-100 bg-gray-50 flex-shrink-0">
      <div class="flex items-center space-x-3 mb-3 px-2">
        <div class="bg-gradient-to-br from-blue-500 to-purple-600 rounded-full p-2 shadow-sm">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-900 truncate"><%= current_user.email_address %></p>
          <p class="text-xs text-gray-500 text-xs">Active</p>
        </div>
      </div>
      <%= button_to session_path, method: :delete, class: "w-full flex items-center justify-center space-x-2 px-4 py-2.5 bg-white border border-gray-200 hover:border-gray-300 text-gray-700 hover:text-gray-900 rounded-xl transition-all duration-200 font-medium text-sm shadow-sm hover:shadow" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span>Sign Out</span>
      <% end %>
    </div>
  </aside>

  <!-- Mobile Overlay -->
  <div id="sidebar-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 lg:hidden hidden" onclick="document.getElementById('sidebar').classList.add('-translate-x-full'); this.classList.add('hidden');"></div>
<% end %>
