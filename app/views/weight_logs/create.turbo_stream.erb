<%= turbo_stream.update "weight_log_form" do %>
  <div class="bg-white rounded-2xl shadow-lg p-6 sticky lg:top-32">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
      <svg class="w-6 h-6 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
      </svg>
      Log Weight
    </h2>

    <%= form_with(model: WeightLog.new, local: true, data: { turbo_frame: "weight_log_form" }, class: "space-y-5") do |f| %>
      <div>
        <%= f.label :weight, class: "block text-sm font-semibold text-gray-700 mb-2 flex items-center" %>
        <div class="relative">
          <%= f.number_field :weight, step: "0.1", placeholder: "Enter weight", class: "w-full px-4 py-3 pl-12 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all duration-200 text-gray-700" %>
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
            <span class="text-gray-500 font-semibold"><%= current_user.profile.unit_preference == 'metric' ? 'kg' : 'lbs' %></span>
          </div>
        </div>
      </div>

      <div>
        <%= f.label :logged_date, class: "block text-sm font-semibold text-gray-700 mb-2 flex items-center" %>
        <div class="relative">
          <%= f.date_field :logged_date, class: "w-full px-4 py-3 pl-12 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all duration-200 text-gray-700" %>
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </div>
      </div>

      <div>
        <%= f.label :notes, class: "block text-sm font-semibold text-gray-700 mb-2 flex items-center" %>
        <%= f.text_area :notes, rows: 3, placeholder: "Add any notes (optional)", class: "w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all duration-200 text-gray-700 resize-none" %>
      </div>

      <%= f.submit "Log Weight", class: "w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2" %>
    <% end %>
  </div>
<% end %>

<%= turbo_stream.update "weight_chart" do %>
  <div class="bg-white rounded-2xl shadow-lg p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-900 flex items-center">
        <svg class="w-6 h-6 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Weight Progress
      </h2>
    </div>
    <div id="weightChart" class="h-96 w-full" data-weight-data="<%= @weight_logs.map { |log| { date: log.logged_date.strftime("%Y-%m-%d"), weight: log.display_weight } }.to_json %>" data-unit="<%= current_user.profile.unit_preference == "metric" ? "kg" : "lbs" %>"></div>
  </div>
<% end %>

<%= turbo_stream.update "weight_history" do %>
  <%= render partial: "weight_history", locals: { weight_logs: @weight_logs } %>
<% end %>





