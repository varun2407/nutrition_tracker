<turbo-frame id="food_search">
  <div class="space-y-6">
    <%= form_with url: food_search_path, method: :get, local: true, class: "space-y-4" do |form| %>
      <%= form.hidden_field :daily_log_id, value: daily_log_id %>
      <div class="relative">
        <%= form.text_field :query,
            placeholder: "Search for food items...",
            class: "w-full px-4 py-3 pl-12 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all duration-200 text-gray-700 placeholder-gray-400" %>
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
      <%= form.submit "Search", class: "w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold py-3 px-6 rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200 cursor-pointer" %>
    <% end %>

    <% if @foods.any? %>
      <div class="space-y-3 max-h-96 overflow-y-auto pr-2 custom-scrollbar">
        <% @foods.each do |food| %>
          <div class="bg-gradient-to-r from-gray-50 to-blue-50 rounded-xl p-4 border border-gray-200 hover:shadow-md transition-all duration-200">
            <div class="mb-3">
              <h3 class="text-lg font-bold text-gray-900 mb-2"><%= food.name %></h3>
              <div class="grid grid-cols-3 gap-3 text-sm">
                <div class="bg-white rounded-lg px-3 py-2 text-center">
                  <div class="text-blue-600 font-bold"><%= food.calories %></div>
                  <div class="text-xs text-gray-500">Calories</div>
                </div>
                <div class="bg-white rounded-lg px-3 py-2 text-center">
                  <div class="text-green-600 font-bold"><%= food.carbs %></div>
                  <div class="text-xs text-gray-500">Carbs (g)</div>
                </div>
                <div class="bg-white rounded-lg px-3 py-2 text-center">
                  <div class="text-purple-600 font-bold"><%= food.protein %></div>
                  <div class="text-xs text-gray-500">Protein (g)</div>
                </div>
              </div>
              <div class="mt-2 bg-white rounded-lg px-3 py-2 text-center">
                <div class="text-orange-600 font-bold"><%= food.fat %></div>
                <div class="text-xs text-gray-500">Fat (g)</div>
              </div>
            </div>

            <%= form_with url: daily_log_food_entries_path(daily_log_id: daily_log_id), method: :post, local: false, class: "space-y-3" do |form| %>
              <%= form.hidden_field :daily_log_id, value: daily_log_id %>
              <%= form.hidden_field :food_id, value: food.id %>
              <%= form.hidden_field :date, value: (@selected_date || Date.today).strftime('%Y-%m-%d') %>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1">Quantity</label>
                  <%= form.number_field :quantity,
                      value: 1,
                      min: 1,
                      step: 0.25,
                      class: "w-full px-3 py-2 border-2 border-gray-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all duration-200 text-gray-700" %>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1">Meal</label>
                  <%= form.select :meal_type,
                      options_for_select([
                        ["🍳 Breakfast", :breakfast],
                        ["🍽️ Lunch", :lunch],
                        ["🌙 Dinner", :dinner],
                        ["🍪 Snacks", :snacks]
                      ]),
                      {},
                      { class: "w-full px-3 py-2 border-2 border-gray-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all duration-200 text-gray-700 bg-white" } %>
                </div>
              </div>

              <%= form.submit "Add to Log", class: "w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-semibold py-2.5 px-4 rounded-lg shadow-md hover:shadow-lg transform hover:scale-105 transition-all duration-200 cursor-pointer" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% elsif params[:query].present? %>
      <div class="bg-red-50 border-2 border-red-200 rounded-xl p-6 text-center">
        <svg class="w-12 h-12 mx-auto text-red-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-red-700 font-medium">No results found</p>
        <p class="text-red-600 text-sm mt-1">No food items found for "<span class="font-semibold"><%= params[:query] %></span>"</p>
        <p class="text-red-500 text-xs mt-2">Try searching with different keywords</p>
      </div>
    <% else %>
      <div class="bg-gradient-to-br from-blue-50 to-purple-50 border-2 border-blue-200 rounded-xl p-8 text-center">
        <svg class="w-16 h-16 mx-auto text-blue-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <p class="text-gray-600 font-medium mb-1">Ready to search</p>
        <p class="text-gray-500 text-sm">Enter a food name above to find nutritional information</p>
      </div>
    <% end %>
  </div>

  <style>
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</turbo-frame>
