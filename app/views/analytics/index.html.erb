<% content_for(:title) { "Analytics | Nutrition Tracker" } %>

<div class="min-h-screen bg-gray-50">
  <!-- Header Section -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 lg:px-8 py-6">
      <h1 class="text-3xl font-bold text-gray-900">Nutrition Analytics</h1>
      <p class="text-gray-500 mt-1">Insights into your nutrition patterns and trends</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 lg:px-8 py-8">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Macro Distribution -->
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
          <svg class="w-6 h-6 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
          </svg>
          Macro Distribution
        </h2>
        <div id="macroChart" class="h-80 w-full"></div>
      </div>

      <!-- Calorie Trends -->
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
          <svg class="w-6 h-6 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          Calorie Trends
        </h2>
        <div id="calorieChart" class="h-80 w-full"></div>
      </div>

      <!-- Meal Timing -->
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
          <svg class="w-6 h-6 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Meal Timing Patterns
        </h2>
        <div id="mealTimingChart" class="h-80 w-full"></div>
      </div>

      <!-- Weekly Report -->
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
          <svg class="w-6 h-6 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Weekly Summary
        </h2>
        <div class="space-y-6">
          <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-xl p-6">
            <div class="flex justify-between items-center">
              <span class="text-gray-700 font-medium">Average Daily Calories</span>
              <span class="text-2xl font-bold text-blue-600"><%= @weekly_report[:average_calories] %> <span class="text-sm text-gray-500">kcal</span></span>
            </div>
          </div>

          <% if @weekly_report[:weight_change] %>
            <div class="bg-gradient-to-r <%= @weekly_report[:weight_change][:change] > 0 ? 'from-red-50 to-orange-50' : 'from-green-50 to-emerald-50' %> rounded-xl p-6">
              <div class="flex justify-between items-center">
                <span class="text-gray-700 font-medium">Weight Change</span>
                <span class="text-2xl font-bold <%= @weekly_report[:weight_change][:change] > 0 ? 'text-red-600' : 'text-green-600' %>">
                  <%= @weekly_report[:weight_change][:change] > 0 ? '+' : '' %><%= @weekly_report[:weight_change][:change] %> <span class="text-sm text-gray-500">kg</span>
                </span>
              </div>
              <p class="text-sm text-gray-600 mt-2">
                <%= @weekly_report[:weight_change][:percentage] %>% change
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  // Macro Distribution Chart
  const macroChart = echarts.init(document.getElementById('macroChart'));
  const macroData = <%= raw @macro_distribution.to_json %>;

  const macroOption = {
    tooltip: {
      trigger: 'item',
      backgroundColor: 'rgba(0, 0, 0, 0.8)',
      borderColor: 'transparent',
      textStyle: { color: '#fff' },
      formatter: '{b}: {c}%'
    },
    series: [{
      type: 'pie',
      radius: ['40%', '70%'],
      avoidLabelOverlap: false,
      itemStyle: {
        borderRadius: 10,
        borderColor: '#fff',
        borderWidth: 2
      },
      label: {
        show: false,
        position: 'center'
      },
      emphasis: {
        label: {
          show: true,
          fontSize: '20',
          fontWeight: 'bold'
        }
      },
      labelLine: {
        show: false
      },
      data: [
        { value: macroData.carbs, name: 'Carbs', itemStyle: { color: '#3B82F6' } },
        { value: macroData.protein, name: 'Protein', itemStyle: { color: '#10B981' } },
        { value: macroData.fat, name: 'Fat', itemStyle: { color: '#F59E0B' } }
      ]
    }]
  };

  macroChart.setOption(macroOption);

  // Calorie Trends Chart
  const calorieChart = echarts.init(document.getElementById('calorieChart'));
  const calorieData = <%= raw @calorie_trends.to_json %>;

  const calorieOption = {
    tooltip: {
      trigger: 'axis',
      backgroundColor: 'rgba(0, 0, 0, 0.8)',
      borderColor: 'transparent',
      textStyle: { color: '#fff' },
      formatter: function(params) {
        const data = params[0];
        return `<div class='p-3'>
          <div class='font-bold text-white mb-1'>${new Date(data.name).toLocaleDateString()}</div>
          <div class='text-blue-400 font-semibold text-lg'>${data.value} kcal</div>
        </div>`;
      }
    },
    xAxis: {
      type: 'category',
      data: Object.keys(calorieData),
      axisLine: { show: false },
      axisTick: { show: false },
      axisLabel: {
        color: '#6B7280',
        fontWeight: '500',
        formatter: function(value) {
          return new Date(value).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        }
      }
    },
    yAxis: {
      type: 'value',
      name: 'Calories',
      axisLine: { show: false },
      axisTick: { show: false },
      splitLine: { lineStyle: { color: '#F3F4F6', width: 1 } },
      axisLabel: {
        color: '#6B7280',
        formatter: '{value} kcal',
        fontWeight: '500'
      }
    },
    series: [{
      data: Object.values(calorieData),
      type: 'line',
      smooth: true,
      showSymbol: true,
      symbolSize: 8,
      itemStyle: { color: '#3B82F6' },
      lineStyle: { width: 3 },
      areaStyle: {
        color: {
          type: 'linear',
          x: 0, y: 0, x2: 0, y2: 1,
          colorStops: [
            { offset: 0, color: 'rgba(59, 130, 246, 0.3)' },
            { offset: 1, color: 'rgba(59, 130, 246, 0.05)' }
          ]
        }
      }
    }],
    grid: {
      left: '10%',
      right: '5%',
      bottom: '15%',
      top: '10%',
      containLabel: true
    }
  };

  calorieChart.setOption(calorieOption);

  // Meal Timing Chart
  const mealTimingChart = echarts.init(document.getElementById('mealTimingChart'));
  const mealTimingData = <%= raw @meal_timing.to_json %>;

  const mealTimingOption = {
    tooltip: {
      trigger: 'axis',
      backgroundColor: 'rgba(0, 0, 0, 0.8)',
      borderColor: 'transparent',
      textStyle: { color: '#fff' },
      formatter: function(params) {
        const data = params[0];
        return `<div class='p-3'>
          <div class='font-bold text-white mb-1'>${data.name}</div>
          <div class='text-green-400 font-semibold text-lg'>Average time: ${data.value}:00</div>
        </div>`;
      }
    },
    xAxis: {
      type: 'category',
      data: Object.keys(mealTimingData).map(meal => meal.charAt(0).toUpperCase() + meal.slice(1)),
      axisLine: { show: false },
      axisTick: { show: false },
      axisLabel: {
        color: '#6B7280',
        fontWeight: '500'
      }
    },
    yAxis: {
      type: 'value',
      name: 'Hour of Day',
      min: 0,
      max: 24,
      axisLine: { show: false },
      axisTick: { show: false },
      splitLine: { lineStyle: { color: '#F3F4F6', width: 1 } },
      axisLabel: {
        color: '#6B7280',
        formatter: '{value}:00',
        fontWeight: '500'
      }
    },
    series: [{
      data: Object.values(mealTimingData),
      type: 'bar',
      itemStyle: {
        color: {
          type: 'linear',
          x: 0, y: 0, x2: 0, y2: 1,
          colorStops: [
            { offset: 0, color: '#10B981' },
            { offset: 1, color: '#059669' }
          ]
        },
        borderRadius: [8, 8, 0, 0]
      },
      barWidth: '50%'
    }],
    grid: {
      left: '15%',
      right: '5%',
      bottom: '15%',
      top: '10%',
      containLabel: true
    }
  };

  mealTimingChart.setOption(mealTimingOption);

  // Handle window resize
  window.addEventListener('resize', function() {
    macroChart.resize();
    calorieChart.resize();
    mealTimingChart.resize();
  });
})();
</script>
