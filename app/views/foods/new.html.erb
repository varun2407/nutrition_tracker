<% content_for(:title) { "New Food | Nutrition Tracker" } %>

<div class="min-h-screen bg-gray-50">
  <!-- Header Section -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 lg:px-8 py-6">
      <h1 class="text-3xl font-bold text-gray-900">Create Custom Food</h1>
      <p class="text-gray-500 mt-1">Add a new food item with nutritional information</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 lg:px-8 py-8">
    <!-- Food Form Card -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8">
      <%= render "form" %>
    </div>
  </div>
</div>

