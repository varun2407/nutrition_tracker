<% content_for(:title) { "Edit Profile | Nutrition Tracker" } %>

<div class="min-h-screen bg-gray-50">
  <!-- Header Section -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 lg:px-8 py-6">
      <h1 class="text-3xl font-bold text-gray-900">Edit Profile</h1>
      <p class="text-gray-500 mt-1">Update your personal information and preferences</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 lg:px-8 py-8">

    <!-- Profile Form Card -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8">
      <%= form_with model: @profile, url: profile_path(@profile), local: true, data: { turbo: true }, class: "space-y-6" do |form| %>
        <% if @profile.errors.any? %>
          <div class="bg-red-50 border-2 border-red-200 rounded-xl p-4 mb-6">
            <div class="flex items-center mb-2">
              <svg class="w-5 h-5 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <h3 class="text-red-800 font-semibold">Please fix the following errors:</h3>
            </div>
            <ul class="list-disc pl-6 text-sm text-red-700 space-y-1">
              <% @profile.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Date of Birth -->
        <div class="space-y-2">
          <%= form.label :birth_date, "Date of Birth", class: "block text-sm font-semibold text-gray-700 flex items-center" %>
          <div class="relative">
            <%= form.date_field :birth_date, class: "w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all duration-200 text-gray-700" %>
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
        </div>

        <!-- Unit Preference -->
        <div class="space-y-4">
          <label class="block text-sm font-semibold text-gray-700 flex items-center mb-3">
            <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1v-3z" />
            </svg>
            Unit System
          </label>

          <div class="grid grid-cols-2 gap-4">
            <label class="relative flex items-center p-4 border-2 rounded-xl cursor-pointer transition-all duration-200 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 <%= @profile.unit_preference == 'metric' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-gray-300' %>">
              <%= form.radio_button :unit_preference, 'metric', class: "sr-only peer", onchange: "this.form.requestSubmit()" %>
              <div class="flex items-center w-full">
                <div class="flex-shrink-0">
                  <div class="w-5 h-5 rounded-full border-2 peer-checked:border-blue-500 peer-checked:bg-blue-500 <%= @profile.unit_preference == 'metric' ? 'border-blue-500 bg-blue-500' : 'border-gray-300' %> flex items-center justify-center">
                    <div class="w-2 h-2 rounded-full bg-white peer-checked:block <%= @profile.unit_preference == 'metric' ? 'block' : 'hidden' %>"></div>
                  </div>
                </div>
                <div class="ml-3 flex-1">
                  <div class="text-sm font-semibold text-gray-900">Metric</div>
                  <div class="text-xs text-gray-500">Centimeters (cm)</div>
                </div>
              </div>
            </label>

            <label class="relative flex items-center p-4 border-2 rounded-xl cursor-pointer transition-all duration-200 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 <%= @profile.unit_preference == 'imperial' ? 'border-blue-500 bg-blue-50' : 'border-gray-200 hover:border-gray-300' %>">
              <%= form.radio_button :unit_preference, 'imperial', class: "sr-only peer", onchange: "this.form.requestSubmit()" %>
              <div class="flex items-center w-full">
                <div class="flex-shrink-0">
                  <div class="w-5 h-5 rounded-full border-2 peer-checked:border-blue-500 peer-checked:bg-blue-500 <%= @profile.unit_preference == 'imperial' ? 'border-blue-500 bg-blue-500' : 'border-gray-300' %> flex items-center justify-center">
                    <div class="w-2 h-2 rounded-full bg-white peer-checked:block <%= @profile.unit_preference == 'imperial' ? 'block' : 'hidden' %>"></div>
                  </div>
                </div>
                <div class="ml-3 flex-1">
                  <div class="text-sm font-semibold text-gray-900">Imperial</div>
                  <div class="text-xs text-gray-500">Feet & Inches (ft/in)</div>
                </div>
              </div>
            </label>
          </div>
        </div>

        <!-- Height Input -->
        <div class="space-y-4">
          <label class="block text-sm font-semibold text-gray-700 flex items-center">
            <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
            Height
          </label>

          <!-- Metric Input -->
          <div class="<%= @profile.unit_preference == 'imperial' ? 'hidden' : '' %>">
            <div class="relative">
              <%= form.number_field :height, step: 0.01, min: 0, placeholder: "Enter height in centimeters", class: "w-full px-4 py-3 pl-12 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all duration-200 text-gray-700" %>
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
              </div>
              <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                <span class="text-gray-500 font-medium">cm</span>
              </div>
            </div>
          </div>

          <!-- Imperial Input -->
          <div class="<%= @profile.unit_preference == 'metric' ? 'hidden' : '' %>">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <%= form.label :height_feet, "Feet", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <div class="relative">
                  <%= form.number_field :height_feet, min: 0, placeholder: "5", class: "w-full px-4 py-3 pl-12 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all duration-200 text-gray-700" %>
                  <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                  </div>
                  <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                    <span class="text-gray-500 font-medium">ft</span>
                  </div>
                </div>
              </div>
              <div>
                <%= form.label :height_inches, "Inches", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <div class="relative">
                  <%= form.number_field :height_inches, min: 0, max: 11.99, step: 0.01, placeholder: "10", class: "w-full px-4 py-3 pl-12 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all duration-200 text-gray-700" %>
                  <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                  </div>
                  <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                    <span class="text-gray-500 font-medium">in</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-end pt-6 border-t border-gray-200">
          <%= link_to "Cancel", root_path, class: "px-6 py-3 mr-4 border-2 border-gray-300 rounded-xl text-gray-700 font-semibold hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition-all duration-200" %>
          <%= button_tag type: :submit, class: "px-8 py-3 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" do %>
            <span class="flex items-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Save Changes
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
